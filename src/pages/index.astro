---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('src/content/pages/home.md is missing');
const { Content } = await render(page);
---
<Base title="Home">
  <h1 class="visually-hidden">Chequamegon Symphony Orchestra</h1>
  {page.data.image && (
    <figure class="hero">
      <img src={page.data.image} alt={page.data.imageAlt ?? ''} width="1200" height="500" />
    </figure>
  )}
  <div class="prose">
    <Content />
  </div>
</Base>
