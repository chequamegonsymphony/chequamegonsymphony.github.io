---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = await getEntry('pages', 'director');
if (!page) throw new Error('src/content/pages/director.md is missing');
const { Content } = await render(page);
---
<Base title="Our Director" description="Nathan Mitchell, Music Director of the Chequamegon Symphony Orchestra">
  <div class="director">
    {page.data.image && (
      <figure class="portrait">
        <img src={page.data.image} alt={page.data.imageAlt ?? ''} width="412" height="302" />
      </figure>
    )}
    <div class="prose">
      <Content />
    </div>
  </div>
</Base>
